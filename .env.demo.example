# .env.demo.example — template environment DEMO. Salin ke .env.demo (gitignored)
# lalu isi rahasianya dengan nilai ACAK BARU (jangan pernah pakai punya prod).
#
#   JWT_SECRET / API_SERVICE_TOKEN WAJIB beda dari prod, supaya token demo tak
#   pernah bisa dipakai di prod dan sebaliknya.

NODE_ENV=production
DATABASE_URL=postgres://wrg_demo_app:<password>@127.0.0.1:5432/wrg_os_demo
API_URL=http://localhost:4200
WEB_PUBLIC_URL=https://demo.example.co.id
AUTH_ENABLED=true
JWT_SECRET=<openssl rand -hex 32>
API_SERVICE_TOKEN=<openssl rand -hex 32>

# ── Semua pekerjaan terjadwal MATI di demo ──────────────────────────────
# Demo tak boleh mengirim WA, memanggil AI, atau menarik Accurate.
AGENT_SCHEDULE_ENABLED=false
REMINDER_SCHEDULE_ENABLED=false
MONITOR_SCHEDULE_ENABLED=false
ACCURATE_SCHEDULE_ENABLED=false
DAILY_SUMMARY_ENABLED=false
WEEKLY_REPORT_ENABLED=false
WEEKEND_BRIEFING_ENABLED=false
DETECT_LEAVE_ENABLED=false
EXTRACT_COMPETITOR_ENABLED=false
NOTIF_TUA_ENABLED=false
NOTIF_QUOTA_ENABLED=false
POLA_ENABLED=false
LIST_MEMBERS_ENABLED=false
NPK_COMPUTE_ENABLED=false
RAPORT_NARRATIVE_ENABLED=false
SALES_ALERT_EVAL_ENABLED=false
WATCHPOINT_SNAPSHOT_ENABLED=false

# ── Sabuk pengaman tambahan ─────────────────────────────────────────────
WA_DRY_RUN=true          # kalaupun ada kode yang mencoba kirim → tak keluar
AI_DRY_RUN=true          # tak ada panggilan OpenRouter (dan tak ada API key)
WA_INBOUND_PROCESS=false
# OPENROUTER_API_KEY sengaja TIDAK diisi
# ACCURATE_* sengaja TIDAK diisi
