# PostgreSQL
PG_PASSWORD=change_me_strong_password
PG_DB=wrg_os
PG_USER=wrg
# Koneksi yang DIPAKAI apps/api (apps/api/src/db.ts hanya membaca DATABASE_URL —
# PG_* di atas dipakai docker-compose/infra, bukan apps/api). WAJIB di-set agar
# DB aktif; kalau kosong, apps/api jalan tanpa DB (mode degradasi).
# Pilih sesuai cara jalan (lihat docs/LOCAL-DEV.md):
#   DB Docker + app native (pnpm dev) — PALING UMUM. NB: compose ekspos host :5433, DB=PG_DB (wrg_os):
#       postgres://${PG_USER}:${PG_PASSWORD}@localhost:5433/wrg_os
#   App juga di Docker (jaringan container, service 'postgres' :5432):
#       postgres://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DB}
#   Postgres native di laptop (:5432, db wrg_os_dev):
#       postgres://localhost:5432/wrg_os_dev
DATABASE_URL=postgres://wrg:change_me_strong_password@localhost:5433/wrg_os

# Redis
REDIS_PASSWORD=change_me_redis_password

# OpenRouter (LLM) — WAJIB di environment services/ai (pemegang kunci & pemanggil
# OpenRouter). Bila ada → agen LLM (A1/A3/A6/A8/A10) jalan live; bila tak ada →
# services/ai otomatis fallback ke template (dry-run). Panggilan live yang gagal
# (key invalid / rate-limit) juga degradasi anggun ke template, bukan 500.
# Slug model bisa di-override: {DAILY,REKAP,RESUME,COLLECTION,SALESDOC,EXTRACT,EXEC}_MODEL_{PRIMARY,FALLBACK}.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# Langfuse (Observability)
LANGFUSE_SECRET=change_me_32char_secret_here_xx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# AWS S3 (Cold Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=wrg-os-cold-archive

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API gateway (server-side): base URL backend domain (apps/api) yang dipanggil
# route handler apps/web. Lokal dev: 4000. Docker: http://api:4000.
API_URL=http://localhost:4000

# AI/data microservice (services/ai) yang dipanggil apps/api. Lokal: 8000. Docker: http://ai:8000.
AI_URL=http://localhost:8000
# Paksa semua agen LLM apps/api ke mode dry-run (hemat token / uji), tanpa peduli
# key di services/ai. Default false → services/ai yang memutuskan live/dry.
AI_DRY_RUN=false

# Raport 360 — narasi AI (Fase 3). Job scheduler generate semua karyawan.
RAPORT_NARRATIVE_ENABLED=false
RAPORT_NARRATIVE_CRON=0 23 * * 1-5
# Model narasi raport (services/ai, OpenRouter). Default Sonnet primary / Haiku fallback.
RAPORT_MODEL_PRIMARY=anthropic/claude-sonnet-4.6
RAPORT_MODEL_FALLBACK=anthropic/claude-haiku-4.5

# NPK Engine (F66) — recompute 8 HoD utk semester berjalan. Display-only (tanpa WA/LLM).
# Tanpa job ini compute hanya lewat POST /npk/compute manual → angka gampang basi.
NPK_COMPUTE_ENABLED=false
NPK_COMPUTE_CRON=0 1 * * *

# WatchPoint Weekly — bekukan metric computed MINGGU LALU ke watchpoint_weekly
# tiap Senin 06:00. Tanpa job ini papan Weekly tak punya riwayat: metric computed
# dihitung live, jadi minggu lewat ikut berubah tiap kali dibuka.
# Idempoten & tidak menimpa input manual HoD.
WATCHPOINT_SNAPSHOT_ENABLED=false
WATCHPOINT_SNAPSHOT_CRON=0 6 * * 1

# Penjadwal agen in-process (apps/api). Default MATI; set true untuk auto-run.
# Cron-expr standar 5-field; TZ default Asia/Jakarta. Tiap run tetap ter-audit.
AGENT_SCHEDULE_ENABLED=false
# Gating granular: nyalakan HANYA reminder (AM note + HOD) tanpa A1-12/monitor/accurate.
REMINDER_SCHEDULE_ENABLED=false
# Compliance reminder per-grup (plan_check pagi / report_check sore) — ikut REMINDER_SCHEDULE_ENABLED.
PLAN_CHECK_CRON=15 8 * * *
REPORT_CHECK_CRON=30 20 * * *
AGENT_CRON_TZ=Asia/Jakarta
A1_CRON=0 */5 * * *
A2_CRON=0 8 * * *
A3_CRON=30 8 * * *
A4_CRON=0 9 * * *
A5_CRON=15 9 * * *
A6_CRON=0 10 * * *
A7_CRON=30 10 * * *
A8_CRON=0 */6 * * *
A9_CRON=0 11 * * *
A10_CRON=30 7 * * *
A11_CRON=0 7 1 * *
A12_CRON=30 7 1 * *
# Reminder AM CRM (port legacy am_reminder). Target = jid grup WA tujuan
# (kosong → stub kirim, mode dev). Cron ikut AGENT_SCHEDULE_ENABLED.
REMINDER_WA_TARGET=
REMINDER_H_CRON=0 7 * * *
REMINDER_HMINUS1_CRON=0 17 * * *
# HOD daily reminder — rekap kepatuhan plan/report ke HOD/grup (08:30).
HOD_WA_TARGET=
HOD_REMINDER_CRON=30 8 * * *
# F38 ED Watch — pindai batch ber-ED (item_stock_batch), peringatkan saat
# melintasi ambang 90/60/30 hari sisa umur. Tiap ambang berbunyi SEKALI
# (penanda alert_tier_terkirim), bukan setiap hari. Flag sendiri, default MATI.
# ED_WATCH_WA_TARGET kosong → TIDAK dikirim (bukan di-broadcast ke grup).
# Tanggal pembanding dihitung WIB di kode, jadi jam cron boleh digeser bebas.
ED_WATCH_ENABLED=false
ED_WATCH_CRON=30 7 * * *
ED_WATCH_WA_TARGET=
# Monitor (port wrg-monitor) — rekap & resume GENERATE-ONLY (tidak kirim WA).
# Cadence legacy: rekap 07/12/17/22 WIB, resume 14:00 & 22:10 WIB.
MONITOR_REKAP_CRON=0 7,12,17,22 * * *
MONITOR_RESUME_CRON=0 14 * * *
MONITOR_RESUME2_CRON=10 22 * * *

# Auth/session (default MATI — set true untuk mengaktifkan gerbang sesi di web
# + enforcement di apps/api). JWT_SECRET menandatangani sesi (HS256).
# API_SERVICE_TOKEN: token kepercayaan BFF→api (web mengirim x-service-token;
# api menerimanya sebagai pengganti JWT user). Bootstrap admin pertama via
# POST /auth/register (terbuka hanya saat belum ada user, lalu butuh service token).
#
# `pnpm dev` (scripts/dev.mjs) memuat .env ini + menjalankan Turbo --env-mode=loose,
# jadi nilai di bawah otomatis sampai ke apps/api & apps/web tiap start. Tanpa
# launcher itu (`pnpm dev:raw` / `turbo run dev` strict-mode), var ini TIDAK
# diteruskan dan AUTH diam-diam tetap MATI.
AUTH_ENABLED=false
JWT_SECRET=change_me_jwt_secret_here
API_SERVICE_TOKEN=change_me_service_token

# WA Gateway
WA_DEVICE_COUNT=3
# Secret webhook gateway WA (openclaw → POST /webhooks/wa). Kosong = tanpa auth
# (dev). Set di prod; gateway harus kirim header x-wa-secret yang sama.
WA_WEBHOOK_SECRET=
# Secret webhook Accurate (→ POST /webhooks/accurate). Kosong = tanpa auth (dev).
# Set di prod; pengirim harus kirim header x-accurate-secret yang sama.
ACCURATE_WEBHOOK_SECRET=
# Puller Accurate Online (POST /accurate/sync + scheduler accurate-sync, port
# sync_accurate.sh). Kredensial: env di bawah, ATAU file JSON ACCURATE_CRED_FILE
# (default ~/.openclaw/credentials/accurate.json) berisi access_token+signature_secret.
ACCURATE_ACCESS_TOKEN=
ACCURATE_SIGNATURE_SECRET=
ACCURATE_HOST=zeus.accurate.id
ACCURATE_CRED_FILE=
ACCURATE_SYNC_CRON=0 10,12,14,16,18,20 * * 1-5
# Pengiriman keluar gateway WA. Tiga mode (lihat src/wasend.ts):
#   WA_SEND_URL kosong            → STUB (dev, tak kirim).
#   WA_SEND_URL set + WA_DRY_RUN!=false → DRY-RUN: terwiring tapi TIDAK kirim live (di-log).
#   WA_SEND_URL set + WA_DRY_RUN=false  → LIVE: POST {to,message} ke gateway.
# WA_DRY_RUN default "true" (aman) — set "false" sebagai langkah go-live terakhir.
# WA_TEST_TARGET: bila di-set, SEMUA tujuan dialihkan ke nomor/jid ini (uji aman).
# Cek wiring tanpa kirim: GET /wa/preflight  (?probe=1 → cek konektivitas gateway).
WA_SEND_URL=
WA_SEND_SECRET=
WA_DRY_RUN=true
WA_TEST_TARGET=
# Pemrosesan inbound #PLAN/#REPORT (pengganti wrg-inbound.sh): parse pesan masuk
# → sales_plan/sales_todo/activity_log + balas grup. Default OFF. Balasan patuh
# WA_DRY_RUN. WA_INBOUND_GROUPS = allowlist jid grup (kosong = semua grup).
WA_INBOUND_PROCESS=false
WA_INBOUND_GROUPS=
