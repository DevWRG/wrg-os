# PostgreSQL
PG_PASSWORD=change_me_strong_password
PG_DB=wrg_os
PG_USER=wrg

# Redis
REDIS_PASSWORD=change_me_redis_password

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# Langfuse (Observability)
LANGFUSE_SECRET=change_me_32char_secret_here_xx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# AWS S3 (Cold Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=wrg-os-cold-archive

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API gateway (server-side): base URL backend domain (apps/api) yang dipanggil
# route handler apps/web. Lokal dev: 4000. Docker: http://api:4000.
API_URL=http://localhost:4000

# AI/data microservice (services/ai) yang dipanggil apps/api. Lokal: 8000. Docker: http://ai:8000.
AI_URL=http://localhost:8000

# Penjadwal agen in-process (apps/api). Default MATI; set true untuk auto-run.
# Cron-expr standar 5-field; TZ default Asia/Jakarta. Tiap run tetap ter-audit.
AGENT_SCHEDULE_ENABLED=false
AGENT_CRON_TZ=Asia/Jakarta
A1_CRON=0 */5 * * *
A2_CRON=0 8 * * *
A3_CRON=30 8 * * *
A4_CRON=0 9 * * *
A5_CRON=15 9 * * *
A6_CRON=0 10 * * *
A7_CRON=30 10 * * *
A8_CRON=0 */6 * * *
A9_CRON=0 11 * * *
A10_CRON=30 7 * * *
A11_CRON=0 7 1 * *

# JWT
JWT_SECRET=change_me_jwt_secret_here

# WA Gateway
WA_DEVICE_COUNT=3
