# Deps & build artifacts — install/build terjadi di dalam image
**/node_modules
**/dist
**/.next
**/.turbo

# VCS
.git
.gitignore

# Env & rahasia lokal (jangan masuk image)
.env
.env.*
!.env.example

# Python
**/__pycache__
**/.venv
*.pyc

# Logs & OS cruft
**/*.log
.DS_Store

# Aset berat non-build (regenerable)
legacy/crm/frontend/screenshots
legacy/crm/frontend/docs/assets
legacy/crm/docs/images
