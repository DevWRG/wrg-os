<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wrg.wa-inbound-watchdog</string>
  <key>ProgramArguments</key>
  <array><string>/Users/development/DevWRG/wrg-os/scripts/ops/wa-inbound-watchdog.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>

  <!-- Skrip ini menembak psql + curl ke bridge (yang memanggil openclaw).
       Tanpa QoS interactive, I/O-nya ikut ter-throttle seperti insiden
       21 Sep 2026 dan alarm justru jadi sumber alarm palsu. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>LowPriorityIO</key><false/>
  <key>LowPriorityBackgroundIO</key><false/>

  <key>StandardOutPath</key><string>/Users/development/DevWRG/ops/logs/wa-inbound-watchdog.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/development/DevWRG/ops/logs/wa-inbound-watchdog.stderr.log</string>
</dict></plist>
