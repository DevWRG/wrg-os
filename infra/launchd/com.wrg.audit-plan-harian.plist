<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wrg.audit-plan-harian</string>
  <key>ProgramArguments</key>
  <array><string>/Users/development/DevWRG/wrg-os/scripts/ops/audit-plan-harian.sh</string></array>

  <!-- 09.00 WIB, Senin-Sabtu. Sesudah gelombang #PLAN pagi (07.30-08.30) supaya
       auditnya bermakna, sebelum siang supaya masih sempat ditindak. -->
