# WRG-OS produksi (Phase 1: co-locate Mac). Salin → .env.prod, isi nilai nyata.
# JANGAN commit .env.prod (gitignored). Dipakai: docker compose -f docker-compose.prod.yml --env-file .env.prod
#
# ── Image ──
WRG_IMAGE_TAG=latest

# ── Database (Postgres HOST, cluster lokal, DB wrg_os_prod) ──
# Container → host: pakai host.docker.internal. Role HARUS berpassword & diizinkan
# di pg_hba.conf untuk subnet docker bridge (lihat docs/CUTOVER.md §Deploy).
DATABASE_URL=postgresql://wrg_app:GANTI_PASSWORD@host.docker.internal:5432/wrg_os_prod

# ── Auth (WAJIB di prod) ──
AUTH_ENABLED=true
JWT_SECRET=GANTI_random_panjang
API_SERVICE_TOKEN=GANTI_random_panjang

# ── AI ──
OPENROUTER_API_KEY=
AI_DRY_RUN=false

# ── Scheduler (default OFF — nyalakan saat cutover) ──
AGENT_SCHEDULE_ENABLED=false
AGENT_CRON_TZ=Asia/Jakarta
MONITOR_REKAP_CRON=0 7,12,17,22 * * *
MONITOR_RESUME_CRON=0 14 * * *
MONITOR_RESUME2_CRON=10 22 * * *
ACCURATE_SYNC_CRON=0 10,12,14,16,18,20 * * 1-5

# ── WhatsApp (lewat wa-bridge HOST) ──
# WA_SEND_URL → bridge /send. WA_DRY_RUN=true → wrg-os TIDAK kirim (default aman).
WA_SEND_URL=http://host.docker.internal:18080/send
WA_SEND_SECRET=GANTI_samakan_dgn_WA_BRIDGE_SECRET
WA_DRY_RUN=true
WA_TEST_TARGET=
WA_WEBHOOK_SECRET=GANTI_samakan_dgn_WRG_WEBHOOK_SECRET
WA_INBOUND_PROCESS=false
WA_INBOUND_GROUPS=
REMINDER_WA_TARGET=
HOD_WA_TARGET=

# ── Accurate (puller) ──
ACCURATE_WEBHOOK_SECRET=
ACCURATE_ACCESS_TOKEN=
ACCURATE_SIGNATURE_SECRET=
ACCURATE_HOST=zeus.accurate.id
# (alternatif: kosongkan token/secret di atas & pakai file)
# ACCURATE_CRED_FILE pada container perlu mount; lebih mudah set token/secret langsung.
